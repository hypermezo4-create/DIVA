{
  "name": "diva-luxury-store",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-commerce.mjs",

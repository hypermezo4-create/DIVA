    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "motion": "12.42.2",
    "next": "16.2.11",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
